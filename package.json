{
  "name": "dsh-anywhere",
  "version": "1.0.0",
  "description": "随身协同 · 实时同屏：手机扫码即同步访问电脑上的 DSH（局域网 3082/3083 + 固定外网/Cloudflare，毫秒级多端协同与断线自愈）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node client/build.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "remote",
    "qr",
    "tunnel",
    "dsh-anywhere"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-session-log-export"
      ],
      "platform": "web"
    }
  }
}
